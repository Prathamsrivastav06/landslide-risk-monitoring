# Database
DATABASE_URL=postgresql://landslide_user:your_password@localhost:5432/landslide_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=landslide_db
DB_USER=landslide_user
DB_PASSWORD=your_secure_password

# NASA Earthdata (register at https://urs.earthdata.nasa.gov/)
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=

# Cesium Ion Token (register at https://ion.cesium.com/ - free tier)
CESIUM_ION_TOKEN=

# Mapbox/MapTiler Token (optional, for premium basemaps)
MAPBOX_TOKEN=

# ML Service
ML_SERVICE_URL=http://localhost:8000

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRY=24h

# Server
PORT=3001
NODE_ENV=development

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@landslide-system.gov.in

# SMS (optional)
SMS_PROVIDER=MSG91
SMS_PROVIDER_KEY=
SMS_SENDER_ID=

# Cache TTL (seconds)
RAINFALL_CACHE_TTL=1800
SOIL_MOISTURE_CACHE_TTL=3600
TERRAIN_CACHE_TTL=86400
HISTORICAL_CACHE_TTL=3600

# Risk Thresholds (configurable)
RISK_LOW_MAX=0.25
RISK_MODERATE_MAX=0.50
RISK_HIGH_MAX=0.75
ALERT_TRIGGER_THRESHOLD=0.50
